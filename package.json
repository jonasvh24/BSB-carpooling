{
  "name": "jvcarpool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm install && prisma migrate deploy && tsx prisma/seed.ts --org && tsx prisma/seed.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "seed:purge": "tsx prisma/seed.ts --purge",
    "recompute": "tsx scripts/recompute.ts",
    "tunnel": "bash scripts/tunnel.sh",
    "backup": "bash scripts/backup.sh",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.19.3",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "dotenv": "17.4.2",
    "leaflet": "1.9.4",
    "next": "16.3.5",
    "next-auth": "5.0.0-beta.32",
    "node-cron": "4.6.0",
    "nodemailer": "8.0.11",
    "prisma": "6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.13.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "5.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
