# Copy to .env and edit. Never commit .env.

DATABASE_URL="file:./dev.db"

# Auth.js. Generate a secret with: openssl rand -base64 32
AUTH_SECRET="change-me"
# Public base URL. Set to the cloudflared tunnel URL when sharing with staff.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Organisation and first site, applied by `npm run setup` / `npm run seed`.
ORG_NAME="The British School of Brussels"
ORG_HEADCOUNT=100
SITE_NAME="Tervuren campus"
# On Netlify SITE_NAME is taken by the platform; set SCHOOL_SITE_NAME there instead.
# SCHOOL_SITE_NAME="Tervuren campus"
SITE_ADDRESS="Pater Dupierreuxlaan 1, 3080 Tervuren"
SITE_LAT=50.8467
SITE_LNG=4.3525
# Comma separated, lower-case. Sign-in is refused outside these unless an admin invited the address.
ALLOWED_EMAIL_DOMAINS="britishschool.be"
# Comma separated. These addresses become ADMIN on first sign-in.
ADMIN_EMAILS="012222@britishschool.be"

# Email. In development the magic link is also printed to the console.
# Mailpit (docker compose up) listens on 1025 and shows mail at http://localhost:8025.
# As soon as AUTH_URL is a public https address, real SMTP is required or sign-in shows an error.
# Free option: Gmail with an App Password -> SMTP_HOST="smtp.gmail.com" SMTP_PORT=587 SMTP_SECURE=false
# SMTP_USER="you@gmail.com" SMTP_PASS="<app password>" EMAIL_FROM="Poolmate <you@gmail.com>".
EMAIL_FROM="Carpool <carpool@example.org>"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false

# Set to true for the real pilot: removes /dev routes and the mailbox helper.
PILOT_MODE=false

# Geo providers (no keys). Nominatim requires an identifying User-Agent.
GEO_USER_AGENT="BSB-carpooling/0.1 (+https://github.com/jonasvh24/BSB-carpooling; you@example.com)"
PHOTON_URL="https://photon.komoot.io"
NOMINATIM_URL="https://nominatim.openstreetmap.org"
OSRM_URL="https://router.project-osrm.org"
# Minimum gap between routing requests in ms. 0 = none. The public OSRM demo server
# asks for about one request per second; set 1000 if you must use it, or run your own
# router (docs/pilot-runbook.md) and leave this at 0.
OSRM_MIN_INTERVAL_MS=0
# Map tiles. Swap for a paid or self-hosted tile server without code changes.
NEXT_PUBLIC_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_TILE_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors"

# Who runs this pilot. Shown on /privacy and /terms; unfilled values are marked there.
CONTROLLER_NAME=""
CONTROLLER_ADDRESS=""
CONTROLLER_COMPANY_NUMBER=""
PRIVACY_CONTACT_EMAIL=""
# Leave empty if no data protection officer has been appointed.
DPO_CONTACT=""

# Optional owner account: an administrator who signs in with a password instead of a
# school mailbox. Leave both empty to switch it off. Use a long password before any
# real staff data is in the system.
OWNER_EMAIL=""
OWNER_PASSWORD=""

# Text messages for "forgot password" codes (Twilio). Leave empty in development:
# the code is printed to the console and shown at /dev/mailbox.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM="+32..."

# Netlify only: secret shared by the scheduled functions and /api/jobs.
JOBS_SECRET=""
